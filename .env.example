# SmartPark AI Environment Configuration

# Server & Dashboard
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Detection & Model Weights
YOLO_MODEL_PATH=yolo26s.pt
RESNET_MODEL_PATH=models/parking_classifier.pth
FALLBACK_YOLO_PATH=yolo26n.pt

# Inference Defaults
DEFAULT_CONFIDENCE_THRESHOLD=0.15
ENABLE_TILING=true
DEFAULT_DECISION_MODE=hybrid

# Logging
LOG_LEVEL=INFO
LOG_FILE=outputs/smartpark.log
